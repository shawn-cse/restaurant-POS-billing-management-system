DATABASE_URL="postgresql://nodedr:nodedr_dev_pw@localhost:5432/nodedr_restaurant"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"
PORT=4000
CORS_ORIGIN="http://localhost:8080"

# Sign-up (POST /auth/register) is first-run setup only: once the server has a
# restaurant it is closed. Set true ONLY if you deliberately host several
# restaurants and accept that each new owner gets instance-level permissions
# (backup, update, sync) - see SECURITY.md.
# ALLOW_PUBLIC_SIGNUP=false

# Encrypts third-party integration credentials at rest (AES-256-GCM). 16+ chars.
# If unset it is derived from JWT_SECRET, so rotating JWT_SECRET would orphan
# saved credentials - set a dedicated key in production and back it up.
# INTEGRATION_SECRET_KEY=
# INTEGRATION_SECRET_KEY_FILE=/run/secrets/integration_key   # alternative: read the key from a file
# PUBLIC_BASE_URL=https://pos.example.com   # payment return page + webhook base
